+#[cfg(test)]
+mod hash_after_tests {
+    use super::*;
+    use crate::movegen::generate_legal_moves;
+    use crate::sfen::board_to_sfen;
+
+    #[test]
+    fn predicted_legal_child_hash_matches_move_and_full_recompute() {
+        let mut positions = [
+            Board::from_sfen("4k4/9/4+p4/9/4R4/9/9/9/4K4 b PLNSGBR 1")
+                .expect("legal test position"),
+            Board::startpos(),
+        ];
+        let mut checked = 0;
+        let mut saw_drop = [false; 7];
+        let mut saw_promotion = false;
+        let mut saw_promoted_capture = false;
+        let mut saw_white = false;
+        let mut saw_king_move = false;
+        for board in &mut positions {
+            let position_start = checked;
+            for step in 0..80 {
+                let moves = generate_legal_moves(board);
+                if moves.is_empty() || checked - position_start >= 5_000 {
+                    break;
+                }
+                for &mv in &moves {
+                    if checked - position_start >= 5_000 {
+                        break;
+                    }
+                    let before = board_to_sfen(board);
+                    let before_hash = board.hash;
+                    let before_acc = board.acc.clone();
+                    let before_hkp = board.hkp.clone();
+                    let before_hand = board.hand;
+                    let before_ply = board.ply;
+                    let predicted = board.hash_after_legal_move(mv);
+                    assert_eq!(board_to_sfen(board), before);
+                    assert_eq!(board.hash, before_hash);
+                    assert_eq!(board.acc, before_acc);
+                    assert_eq!(board.hkp, before_hkp);
+                    assert_eq!(board.hand, before_hand);
+                    assert_eq!(board.ply, before_ply);
+
+                    let mut child = board.clone();
+                    child.do_move_for_search(mv);
+                    assert_eq!(predicted, child.hash(), "move {mv:?} from {before}");
+                    let mailbox = child.mailbox.map(|piece| piece.map(|p| (p.color, p.kind)));
+                    let hand_counts = hand_counts_array(&child.hand);
+                    assert_eq!(
+                        predicted,
+                        zobrist::compute_hash(&mailbox, &hand_counts, child.side_to_move)
+                    );
+
+                    if mv.is_drop() {
+                        let hand_kinds = [
+                            PieceKind::Fu,
+                            PieceKind::Kyou,
+                            PieceKind::Kei,
+                            PieceKind::Gin,
+                            PieceKind::Kin,
+                            PieceKind::Kaku,
+                            PieceKind::Hisha,
+                        ];
+                        saw_drop[hand_kinds
+                            .iter()
+                            .position(|&kind| kind == mv.piece_kind)
+                            .unwrap()] = true;
+                    }
+                    saw_promotion |= mv.promote;
+                    saw_promoted_capture |=
+                        board.piece_at(mv.to).is_some_and(|p| p.kind.is_promoted());
+                    saw_white |= board.side_to_move == Color::White;
+                    saw_king_move |= mv.piece_kind == PieceKind::Ou;
+                    checked += 1;
+                }
+                let chosen = moves[(step * 31 + 7) % moves.len()];
+                board.do_move_for_search(chosen);
+            }
+        }
+        assert!(checked > 1000);
+        assert!(
+            saw_drop.into_iter().all(|seen| seen),
+            "all hand kinds must be covered"
+        );
+        assert!(saw_promotion);
+        assert!(saw_promoted_capture);
+        assert!(saw_white);
+        assert!(saw_king_move);
+    }
+}
