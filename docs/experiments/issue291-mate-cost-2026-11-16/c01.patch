+    /// Predict the hash after a legal move without changing board state or
+    /// invalidating its legality cache. Callers must supply a generated legal
+    /// move; this does not validate the move or apply it.
+    #[inline]
+    pub(crate) fn hash_after_legal_move(&self, mv: Move) -> u64 {
+        let color = self.side_to_move;
+        let mut hash = self.hash ^ zobrist::side_key();
+        if let Some(from) = mv.from {
+            let moved = self.mailbox[from.index() as usize].expect("legal move has a source");
+            debug_assert_eq!(moved.color, color);
+            debug_assert_eq!(moved.kind, mv.piece_kind);
+            hash ^= zobrist::piece_key(from, color, moved.kind);
+            if let Some(captured) = self.mailbox[mv.to.index() as usize] {
+                let base = captured.kind.unpromoted();
+                let new_count = self.hand[color.index()].get(base) + 1;
+                hash ^= zobrist::piece_key(mv.to, captured.color, captured.kind);
+                hash ^= zobrist::hand_delta(color, base, new_count);
+            }
+            let destination_kind = if mv.promote {
+                moved.kind.promoted()
+            } else {
+                moved.kind
+            };
+            hash ^= zobrist::piece_key(mv.to, color, destination_kind);
+        } else {
+            let count = self.hand[color.index()].get(mv.piece_kind);
+            debug_assert!(count > 0);
+            hash ^= zobrist::hand_delta(color, mv.piece_kind, count);
+            hash ^= zobrist::piece_key(mv.to, color, mv.piece_kind);
+        }
+        hash
+    }
